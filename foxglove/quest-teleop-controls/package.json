  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.2",
    "@foxglove/extension": "3.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "create-foxglove-extension": "1.3.2",
    "css-loader": "7.1.5",
    "eslint": "9.39.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "style-loader": "4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
