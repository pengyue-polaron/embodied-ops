{
  "name": "quest-teleop-controls",
  "displayName": "Quest Teleop Controls",
  "description": "Compact operator controls for the canonical Quest teleoperation services.",
  "publisher": "pengyue-robotics",
  "homepage": "https://github.com/pengyue-polaron/embodied-ops",
  "version": "1.3.2",
  "license": "MIT",
  "main": "./dist/extension.js",
  "keywords": [
    "foxglove",
    "quest",
    "robotics",
    "teleoperation"
  ],
  "overrides": {
    "tar": "7.5.22",
    "webpack": "5.110.3"
  },
  "scripts": {
